CHAT_APP_NAME="PHP WebSocket Chat"
CHAT_DEBUG=false

# XAMPP MariaDB/MySQL.
CHAT_DB_CONNECTION=mysql
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=3306
CHAT_DB_DATABASE=php_websocket_chat
CHAT_DB_USERNAME=root
CHAT_DB_PASSWORD=

# SQLite remains available for local fallback/testing:
# CHAT_DB_CONNECTION=sqlite
# CHAT_DB_DATABASE=storage/chat.sqlite

CHAT_SESSION_NAME=phpchat_session
CHAT_WS_ENABLED=true
CHAT_WS_HOST=0.0.0.0
CHAT_WS_PORT=8080
